{
  "name": "autark",
  "productName": "Autark",
  "version": "0.3.5",
  "private": true,
  "description": "Local-first AI workforce: agents, chats, tasks and a calm to-do list",
  "author": "Teydra",
  "license": "Apache-2.0",
  "type": "module",
  "main": "app/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "runtime": "node scripts/build.mjs --only runtime && node app/runtime-cli.mjs",
    "wf": "node app/wf.mjs",
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.runtime.json && tsc -p tsconfig.main.json && tsc -p tsconfig.ui.json",
    "boundaries": "node scripts/check-boundaries.mjs",
    "test": "node --test --test-concurrency=2 \"test/unit/**/*.test.ts\"",
    "test:ui": "node scripts/build.mjs && node --test --test-concurrency=1 \"test/ui/**/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.mjs\"",
    "test:live": "node --test --test-concurrency=1 \"test/live/*.test.ts\"",
    "check": "npm run typecheck && npm run boundaries && npm test",
    "package": "npm run build && node scripts/package-desktop.mjs --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@thednp/dommatrix": "3.1.2",
    "croner": "10.0.1",
    "electron-updater": "6.8.9",
    "onnxruntime-web": "1.31.1",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.61.1",
    "qrcode": "1.5.4",
    "sherpa-onnx-node": "2.0.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@preact/signals": "2.11.3",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "dompurify": "3.4.17",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "marked": "18.1.1",
    "mermaid": "12.2.0",
    "playwright": "1.61.1",
    "preact": "10.29.8",
    "typescript": "7.0.2"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "com.teydralab.workforce",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "app/**/*",
      "resources/**/*",
      "assets/icon.png",
      "assets/icons/**/*",
      "package.json",
      "!node_modules/@napi-rs/**/*",
      "!node_modules/onnxruntime-web/{dist,lib,docs}/**/*",
      "node_modules/onnxruntime-web/dist/ort.node.min.js",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm"
    ],
    "asarUnpack": [
      "resources/**/*.ps1",
      "resources/**/*.py",
      "app/wf.mjs",
      "app/meet.mjs",
      "node_modules/sherpa-onnx-*/**",
      "node_modules/onnxruntime-web/**",
      "node_modules/onnxruntime-common/**"
    ],
    "artifactName": "autark-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "desquerteur",
      "repo": "OpenAutark",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "autark-windows-${arch}.${ext}",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "autark-mac-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "autark-linux-x64.${ext}",
      "category": "Office",
      "icon": "assets/icon.png"
    }
  }
}
